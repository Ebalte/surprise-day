{
  "name": "surprise-day",
  "private": true,
  "version": "0.1.0",
  "description": "Сайт-игра «Сюрприз дня» — ежедневное яйцо с фигурками",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "db:migrate": "npm run db:migrate -w server",
    "db:sync-seasons": "npm run db:sync-seasons -w server"
  },
  "engines": {
    "node": ">=20"
  }
}
