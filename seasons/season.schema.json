{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Season config",
  "type": "object",
  "required": [
    "slug",
    "number",
    "title",
    "startsAt",
    "isActive",
    "rules",
    "badge",
    "figures"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "startsAt": {
      "type": "string",
      "format": "date-time"
    },
    "endsAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isActive": {
      "type": "boolean",
      "description": "Активным может быть только один сезон"
    },
    "rules": {
      "type": "object",
      "required": [
        "rarities",
        "pityThreshold",
        "craftCosts"
      ],
      "properties": {
        "rarities": {
          "type": "object",
          "description": "weight — относительный вес выпадения, shards — осколки за дубликат",
          "propertyNames": {
            "enum": [
              "common",
              "rare",
              "epic",
              "legendary"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "weight",
              "shards"
            ],
            "properties": {
              "weight": {
                "type": "number",
                "minimum": 0
              },
              "shards": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "pityThreshold": {
          "type": "integer",
          "minimum": 1,
          "description": "Сколько яиц подряд без новинки до гаранта"
        },
        "craftCosts": {
          "type": "object",
          "description": "Цена фигурки в осколках по редкости. Редкость, которой нет в списке, купить нельзя",
          "propertyNames": { "enum": ["common", "rare", "epic", "legendary"] },
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "trading": {
          "type": "object",
          "description": "Подарки и обмен между игроками",
          "properties": {
            "giftsPerDay": {
              "type": "integer",
              "minimum": 0
            },
            "tradeableRarities": {
              "type": "array",
              "items": {
                "enum": [
                  "common",
                  "rare",
                  "epic",
                  "legendary"
                ]
              }
            },
            "offerTtlHours": {
              "type": "number",
              "minimum": 1
            }
          }
        },
        "pityHintFrom": {
          "type": "integer",
          "description": "С какого числа оставшихся яиц показывать подсказку о гарантированной новинке"
        },
        "streakFreezesPerWeek": {
          "type": "integer",
          "minimum": 0
        },
        "shop": {
          "type": "object",
          "description": "Яйца за Telegram Stars и рекламу",
          "properties": {
            "eggPricesStars": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1 },
              "description": "Цена 1-й, 2-й, 3-й покупки. Сбрасывается к первой цене вместе с новым яйцом дня"
            },
            "adEggsPerDay": {
              "type": "integer"
            }
          }
        },
        "quests": {
          "type": "array",
          "description": "Задания недели",
          "items": {
            "type": "object",
            "required": [
              "code",
              "title",
              "event",
              "goal",
              "shards"
            ],
            "properties": {
              "event": {
                "enum": [
                  "egg_opened",
                  "new_figure",
                  "gift_sent",
                  "trade_done"
                ]
              }
            }
          }
        }
      }
    },
    "badge": {
      "type": "object",
      "required": [
        "code",
        "title"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        }
      }
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "rarity",
          "image"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$",
            "description": "Стабильный ID фигурки — не меняйте после запуска"
          },
          "name": {
            "type": "string"
          },
          "rarity": {
            "enum": [
              "common",
              "rare",
              "epic",
              "legendary"
            ]
          },
          "image": {
            "type": "string",
            "description": "Путь от web/public или полный URL"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "album": {
      "type": "object",
      "description": "Ряды альбома с наградами и наборы, за которые дают рамки аватарки",
      "properties": {
        "rows": {
          "type": "array"
        },
        "sets": {
          "type": "array"
        }
      }
    },
    "events": {
      "type": "array",
      "description": "Временные события с особыми фигурками (не входят в основную коллекцию)",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "title",
          "startsAt",
          "endsAt",
          "dropChance",
          "badge",
          "figures"
        ]
      }
    }
  }
}
