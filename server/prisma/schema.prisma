// Схема БД «Сюрприз дня».
// Сезоны и фигурки НЕ редактируются руками в БД — они синхронизируются
// из файлов seasons/*.json командой `npm run db:sync-seasons`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

/// Откуда пришла фигурка
enum DropSource {
  DAILY // бесплатное яйцо раз в 24 часа
  STREAK_BONUS // 7 дней подряд
  REFERRAL_BONUS // друг открыл своё первое яйцо
  FRIENDS_MILESTONE // 3 / 10 друзей
  CRAFT // обмен осколков на фигурку
  GIFT // подарок от другого игрока
  TRADE // обмен с другим игроком
  ALBUM_ROW // собран ряд альбома
  EVENT_REWARD // собрана коллекция события
  AD // за просмотр рекламы
  PURCHASE // куплено за Telegram Stars
  ADMIN // выдано администратором через админ-бота
}

enum AdPlacement {
  REWARDED // показ за бонусное яйцо (с таймером)
  BANNER // карточка на главном экране
}

enum TradeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

// ---------------------------------------------------------------- seasons

model Season {
  id         Int       @id @default(autoincrement())
  slug       String    @unique // "season1" — совпадает с именем файла
  number     Int       @unique
  title      String
  startsAt   DateTime
  endsAt     DateTime?
  isActive   Boolean   @default(false)
  /// Правила сезона из JSON: веса редкостей, осколки, гарант, цена крафта
  rules      Json
  badgeCode  String
  badgeTitle String
  badgeIcon  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  figures     Figure[]
  userSeasons UserSeason[]
  drops       EggLog[]

  @@index([isActive])
  @@map("seasons")
}

model Figure {
  id          Int     @id @default(autoincrement())
  seasonId    Int
  /// Стабильный ID из конфига (например "fox"). Не меняйте после запуска.
  code        String
  name        String
  rarity      Rarity
  image       String
  description String?
  sortOrder   Int     @default(0)
  /// false, если фигурку удалили из JSON (у игроков она остаётся)
  isEnabled   Boolean @default(true)
  /// slug события, если это временная фигурка события (не входит в основную коллекцию сезона).
  /// Окно выпадения (startsAt/endsAt) и шанс берутся из seasons.rules.events.
  eventSlug   String?

  season     Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  owners     UserFigure[]
  drops      EggLog[]
  gifts      Gift[]
  tradesGive Trade[]      @relation("TradeGive")
  tradesWant Trade[]      @relation("TradeWant")

  @@unique([seasonId, code])
  @@index([seasonId, rarity])
  @@index([seasonId, eventSlug])
  @@map("figures")
}

// ---------------------------------------------------------------- users

/// Один Telegram-аккаунт = один игрок (telegramId уникален).
/// Вход на сайт — через Telegram Login Widget, данные проверяются по HMAC на сервере.
model User {
  id           Int     @id @default(autoincrement())
  telegramId   BigInt  @unique
  username     String?
  firstName    String?
  lastName     String?
  languageCode String?
  photoUrl     String?
  isPremium    Boolean @default(false)

  /// Когда открыто последнее бесплатное яйцо. Следующее доступно через 24 ч.
  lastFreeEggAt    DateTime?
  /// Текущая серия дней и лучшая серия
  streak           Int       @default(0)
  bestStreak       Int       @default(0)
  /// Неделя (понедельник, YYYY-MM-DD), в которую потрачена заморозка серии
  streakFreezeWeek String?
  /// Выбранная рамка аватарки (код из album.sets[].frame.code)
  activeFrame      String?

  /// Осколки общие для всех сезонов (тратятся на фигурки активного сезона)
  shards     Int       @default(0)
  totalEggs  Int       @default(0)
  firstEggAt DateTime?

  /// Питомец: код фигурки, которая сейчас «живёт» на главном экране. Время идёт только у неё.
  activePet   String?
  /// Монеты питомца (за мини-игры, тратятся на еду)
  coins       Int     @default(40)
  /// Запас еды: { berry: 3, cookie: 1, ... }
  petFood     Json    @default("{\"berry\":3,\"cookie\":1}")
  /// Рекорды мини-игр: { tower: 12, asmr: 90 }
  gameBest    Json    @default("{}")
  gamesPlayed Int     @default(0)
  /// Напоминания бота о питомце (голод, грязь, скука, усталость). Работают, если включены уведомления.
  petNotify   Boolean @default(true)
  /// Полученные стили питомца (наряды и комнаты): ["outfit:metal", "room:metal"]
  cosmetics   Json    @default("[]")
  /// Что сейчас надето и как оформлена комната (null — обычный вид)
  petOutfit   String?
  roomTheme   String?

  /// Пользователь включил уведомления на сайте и разрешил боту писать в личку
  /// (галочка при входе через виджет или /start в боте)
  notificationsEnabled Boolean   @default(false)
  /// Когда отправили «яйцо готово» (чтобы не слать повторно в том же цикле)
  eggReadyNotifiedAt   DateTime?
  /// Бот заблокирован пользователем — не пытаемся писать
  botBlocked           Boolean   @default(false)
  /// Заблокирован администратором: API отвечает 403
  isBanned             Boolean   @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  figures        UserFigure[]
  seasons        UserSeason[]
  drops          EggLog[]
  grants         EggGrant[]
  badges         UserBadge[]
  /// Кого пригласил этот пользователь
  invited        Referral[]   @relation("Inviter")
  /// Кто пригласил этого пользователя (максимум один)
  invitedBy      Referral?    @relation("Invitee")
  giftsSent      Gift[]       @relation("GiftSender")
  giftsReceived  Gift[]       @relation("GiftReceiver")
  tradesSent     Trade[]      @relation("TradeFrom")
  tradesReceived Trade[]      @relation("TradeTo")
  quests         UserQuest[]
  rewards        UserReward[]
  purchases      Purchase[]
  pets           Pet[]
  gameRuns       GameRun[]
  stories        StoryImage[]
  promoClaims    PromoClaim[]
  pairsOwned     Pair[]       @relation("PairOwner")
  pairsJoined    Pair[]       @relation("PairPartner")
  petLog         PetLog[]

  @@index([notificationsEnabled, lastFreeEggAt])
  @@map("users")
}

/// Прогресс игрока в конкретном сезоне
model UserSeason {
  id          Int       @id @default(autoincrement())
  userId      Int
  seasonId    Int
  /// Яиц подряд без новой фигурки (для гаранта)
  dryStreak   Int       @default(0)
  eggsOpened  Int       @default(0)
  uniqueCount Int       @default(0)
  /// Первое яйцо в сезоне — старт отсчёта для таблицы лидеров
  startedAt   DateTime  @default(now())
  /// Собрал всю коллекцию сезона
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@index([seasonId, completedAt])
  @@map("user_seasons")
}

model UserFigure {
  id              Int      @id @default(autoincrement())
  userId          Int
  figureId        Int
  /// Сколько раз выпадала (1 = без дубликатов)
  count           Int      @default(1)
  firstObtainedAt DateTime @default(now())
  lastObtainedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  figure Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@unique([userId, figureId])
  @@map("user_figures")
}

// ---------------------------------------------------------------- eggs

/// Журнал всех полученных фигурок (яйца + крафт)
model EggLog {
  id          Int        @id @default(autoincrement())
  userId      Int
  seasonId    Int
  figureId    Int
  source      DropSource
  rarity      Rarity
  isNew       Boolean
  /// +осколки за дубликат, либо −цена крафта
  shardsDelta Int        @default(0)
  /// Сработал гарант «10 яиц без новинки»
  pityApplied Boolean    @default(false)
  createdAt   DateTime   @default(now())

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  figure Figure    @relation(fields: [figureId], references: [id], onDelete: Cascade)
  grant  EggGrant?

  @@index([userId, createdAt])
  @@index([seasonId])
  @@map("eggs_log")
}

/// Бонусное яйцо, лежащее «в запасе» у игрока
model EggGrant {
  id        Int        @id @default(autoincrement())
  userId    Int
  source    DropSource
  /// Минимальная гарантированная редкость (3 друга → RARE, 10 друзей → EPIC)
  minRarity Rarity?
  /// Ключ идемпотентности: "referral:42", "friends:3", "streak:14"...
  /// Не даёт выдать одну и ту же награду дважды при гонках запросов.
  dedupeKey String
  createdAt DateTime   @default(now())
  usedAt    DateTime?
  eggLogId  Int?       @unique

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  eggLog EggLog? @relation(fields: [eggLogId], references: [id])

  @@unique([userId, dedupeKey])
  @@index([userId, usedAt])
  @@map("egg_grants")
}

// ---------------------------------------------------------------- social

model Referral {
  id          Int       @id @default(autoincrement())
  inviterId   Int
  /// У каждого игрока может быть только один пригласивший
  inviteeId   Int       @unique
  /// Создаётся при первом входе друга, пришедшего по ссылке /?ref=<inviterId>
  createdAt   DateTime  @default(now())
  /// Друг открыл первое яйцо → реферал засчитан, награда выдана
  qualifiedAt DateTime?

  inviter User @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User @relation("Invitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviterId, qualifiedAt])
  @@map("referrals")
}

// ---------------------------------------------------------------- gifts & trades
// Правила (лимит подарков, какие редкости можно передавать, срок жизни предложения)
// задаются в rules.trading конфига сезона.
// Отдавать можно только повторки (user_figures.count > 1) и только друзьям
// (связь в referrals в любую сторону, друг открыл первое яйцо).
// Копия отправителя списывается сразу при создании подарка/предложения (эскроу),
// поэтому одну и ту же фигурку нельзя пообещать двоим.

model Gift {
  id         Int       @id @default(autoincrement())
  senderId   Int
  receiverId Int
  figureId   Int
  createdAt  DateTime  @default(now())
  /// Получатель забрал подарок во «Входящих»
  claimedAt  DateTime?

  sender   User   @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User   @relation("GiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  figure   Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@index([receiverId, claimedAt])
  @@index([senderId, createdAt]) // подсчёт лимита подарков за сутки
  @@map("gifts")
}

model Trade {
  id           Int         @id @default(autoincrement())
  fromUserId   Int
  toUserId     Int
  /// Что отдаёт инициатор (уже списано у него до ответа)
  giveFigureId Int
  /// Что инициатор хочет получить (списывается у второго игрока при принятии)
  wantFigureId Int
  status       TradeStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  respondedAt  DateTime?
  /// Если не ответили до этого времени — EXPIRED, копия возвращается инициатору
  expiresAt    DateTime

  fromUser   User   @relation("TradeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User   @relation("TradeTo", fields: [toUserId], references: [id], onDelete: Cascade)
  giveFigure Figure @relation("TradeGive", fields: [giveFigureId], references: [id], onDelete: Cascade)
  wantFigure Figure @relation("TradeWant", fields: [wantFigureId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@index([status, expiresAt])
  @@map("trades")
}

model UserBadge {
  id        Int      @id @default(autoincrement())
  userId    Int
  /// "badge" — бейдж в профиле, "frame" — рамка аватарки
  kind      String   @default("badge")
  /// Код из конфига сезона, например "collector_season1" или "frame_gold"
  code      String
  title     String
  icon      String?
  seasonId  Int?
  awardedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@map("user_badges")
}

// ---------------------------------------------------------------- album, quests, shop

/// Полученные разовые награды: ряды альбома, наборы, коллекция события.
/// code: "row:0", "set:commons", "event:fireflies". Уникальность не даёт выдать награду дважды.
model UserReward {
  id        Int      @id @default(autoincrement())
  userId    Int
  seasonId  Int
  code      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId, code])
  @@map("user_rewards")
}

/// Прогресс по заданиям недели. weekKey — понедельник недели (UTC), "2026-10-26".
model UserQuest {
  id        Int       @id @default(autoincrement())
  userId    Int
  weekKey   String
  questCode String
  progress  Int       @default(0)
  claimedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey, questCode])
  @@map("user_quests")
}

/// Оплата яйца в Telegram Stars. Яйцо выдаётся только после successful_payment от бота.
/// Яйца за рекламу отдельной таблицы не требуют: это egg_grants с dedupeKey "ad:<дата>".
model Purchase {
  id               Int       @id @default(autoincrement())
  userId           Int
  /// telegram_payment_charge_id — нужен для возврата и защиты от повторной обработки
  telegramChargeId String    @unique
  stars            Int
  payload          String
  /// Звёзды возвращены игроку через админ-бота
  refundedAt       DateTime?
  refundedBy       BigInt?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("purchases")
}

// ---------------------------------------------------------------- admin

/// Рекламная кампания. Создаётся в админ-боте.
/// Картинка/видео хранится в Telegram: mediaFileId принадлежит АДМИН-боту,
/// сайт получает файл через прокси API (/api/ads/:id/media).
model AdCampaign {
  id             Int         @id @default(autoincrement())
  /// Внутреннее название для списка в админ-боте
  title          String
  placement      AdPlacement
  text           String
  mediaFileId    String?
  /// "photo" | "video"
  mediaType      String?
  buttonText     String?
  url            String?
  /// Сколько секунд нужно смотреть рекламу за яйцо (REWARDED)
  durationSec    Int         @default(5)
  /// Относительная частота показа среди активных кампаний
  weight         Int         @default(1)
  startsAt       DateTime?
  endsAt         DateTime?
  maxImpressions Int?
  isActive       Boolean     @default(false)
  impressions    Int         @default(0)
  completions    Int         @default(0)
  clicks         Int         @default(0)
  createdBy      BigInt
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  views AdView[]

  @@index([placement, isActive])
  @@map("ad_campaigns")
}

/// Один показ рекламы игроку. Яйцо выдаётся только если с startedAt прошло durationSec.
model AdView {
  id          Int       @id @default(autoincrement())
  campaignId  Int
  userId      Int
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  clickedAt   DateTime?

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("ad_views")
}

/// Настройки, изменённые через админ-бота. Перекрывают значения из seasons/*.json
/// без перезапуска. Удаление строки = вернуть значение из файла.
model Setting {
  key       String   @id
  value     Json
  updatedBy BigInt?
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// Журнал действий администраторов
model AdminLog {
  id        Int      @id @default(autoincrement())
  adminId   BigInt
  action    String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("admin_log")
}

// ---------------------------------------------------------------- pets

/// Питомец — фигурка, которую игрок хоть раз делал главным. Показатели 0..100.
/// Пока питомец не главный, он «на паузе»: last и возраст не двигаются.
model Pet {
  id          Int       @id @default(autoincrement())
  /// Хозяин личного питомца. У общего питомца пати — null (он принадлежит паре, см. Pair.petId)
  userId      Int?
  figureCode  String
  level       Int       @default(1)
  xp          Int       @default(0)
  food        Float     @default(80)
  mood        Float     @default(80)
  clean       Float     @default(80)
  energy      Float     @default(80)
  asleep      Boolean   @default(false)
  /// До какого момента показатели уже пересчитаны
  last        DateTime  @default(now())
  /// Накопленный возраст (мс) за прошлые периоды, когда питомец был главным
  ageMs       Float     @default(0)
  /// С какого момента питомец снова главный (null — на паузе)
  activeSince DateTime?
  /// Последняя достигнутая стадия возраста (за новую дают монеты один раз)
  stage       Int       @default(0)
  lastPatAt   DateTime?
  /// О каких нуждах бот уже напомнил: { food: true, clean: true, ... } — сбрасывается, когда нужда закрыта
  notified    Json      @default("{}")
  lastNotifyAt DateTime?
  createdAt   DateTime  @default(now())

  user User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pair Pair?
  log  PetLog[]

  @@unique([userId, figureCode])
  @@index([activeSince])
  @@map("pets")
}

/// Запуск мини-игры: сервер выдаёт id при старте и проверяет результат при финише
model GameRun {
  id         Int       @id @default(autoincrement())
  userId     Int
  game       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  score      Int?
  coins      Int?
  /// Игра за общего питомца пати (очки идут в командную цель дня)
  pairId     Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([game, finishedAt])
  @@map("game_runs")
}

/// Картинка для сторис: Telegram берёт её по публичной https-ссылке. Хранится 3 дня.
model StoryImage {
  id        String   @id
  userId    Int
  data      Bytes
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("story_images")
}

// ---------------------------------------------------------------- promo links

/// Ссылка-подарок из админ-бота: даёт набор стилей питомца. Получить её может и новый, и старый игрок, каждый — один раз.
model PromoLink {
  id        Int      @id @default(autoincrement())
  /// Код в ссылке: ?startapp=promo_<code>
  code      String   @unique
  /// Что даёт (ключ из PROMO_PACKS в server/src/game/cosmetics.ts)
  pack      String
  /// Сколько раз можно получить всего (null — без ограничения)
  maxUses   Int?
  uses      Int      @default(0)
  isActive  Boolean  @default(true)
  createdBy BigInt
  createdAt DateTime @default(now())

  claims PromoClaim[]

  @@map("promo_links")
}

model PromoClaim {
  id        Int      @id @default(autoincrement())
  promoId   Int
  userId    Int
  createdAt DateTime @default(now())

  promo PromoLink @relation(fields: [promoId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoId, userId])
  @@map("promo_claims")
}

// ---------------------------------------------------------------- party: общий питомец на двоих

/// Пати из двух игроков (пара или друзья) с общим питомцем. Игрок состоит максимум в одной пати.
model Pair {
  id         Int       @id @default(autoincrement())
  /// "couple" — пара ❤️, "friends" — друзья 🤝 (меняет только оформление)
  kind       String    @default("couple")
  ownerId    Int
  partnerId  Int?
  /// Код приглашения: ссылка ?startapp=pair_<код> или ввод вручную. Меняется, когда место освобождается.
  inviteCode String    @unique
  petId      Int       @unique
  /// Серия дней, когда о питомце позаботились оба
  careStreak Int       @default(0)
  createdAt  DateTime  @default(now())
  joinedAt   DateTime?

  owner   User  @relation("PairOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  partner User? @relation("PairPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  pet     Pet   @relation(fields: [petId], references: [id], onDelete: Cascade)
  days    PairDay[]

  @@index([ownerId])
  @@index([partnerId])
  @@map("pairs")
}

/// День пати (по Москве): кто заботился и сколько очков набрали в совместных играх
model PairDay {
  id            Int     @id @default(autoincrement())
  pairId        Int
  day           String  // YYYY-MM-DD
  ownerCared    Boolean @default(false)
  partnerCared  Boolean @default(false)
  ownerPoints   Int     @default(0)
  partnerPoints Int     @default(0)
  teamRewarded  Boolean @default(false)

  pair Pair @relation(fields: [pairId], references: [id], onDelete: Cascade)

  @@unique([pairId, day])
  @@map("pair_days")
}

/// Кто что делал с общим питомцем (последние записи видны обоим)
model PetLog {
  id        Int      @id @default(autoincrement())
  petId     Int
  userId    Int
  action    String
  createdAt DateTime @default(now())

  pet  Pet  @relation(fields: [petId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([petId, createdAt])
  @@map("pet_log")
}
