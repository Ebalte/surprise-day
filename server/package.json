{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:sync-seasons": "tsx --env-file=../.env prisma/sync-seasons.ts",
    "db:sync-seasons:prod": "node dist/prisma/sync-seasons.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:studio": "dotenv -e ../.env -- prisma studio",
    "admin:dev": "tsx watch --env-file=../.env src/admin/index.ts",
    "admin:start": "node dist/src/admin/index.js",
    "test": "tsx --env-file=../.env --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@prisma/client": "^6.16.0",
    "fastify": "^5.12.7",
    "grammy": "^1.46.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv-cli": "^11.1.0",
    "prisma": "^6.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
